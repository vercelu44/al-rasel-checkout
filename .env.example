AMS_PUBLIC_KEY=<your-ams-public-key>
AMS_PRIVATE_KEY=<your-ams-private-key>
GOOGLE_ID=<your-google-client-id>
GOOGLE_SECRET=<your-google-client-secret>
NEXT_PUBLIC_PRIMARY_COLOR="#283990"
NEXT_PUBLIC_HEADER_BACKGROUND="#F6E921"
NEXT_PUBLIC_HEADER_FOREGROUND="#0f172a"
NEXT_PUBLIC_CURRENCY=AED

# Micsoft Clarity
# NEXT_PUBLIC_CLARITY_PROJECT_ID=<your-clarity-project-id>

NEXT_PUBLIC_BASE_URL=http://localhost:3001
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=<your-nextauth-secret>

# Akaar Server (Common)
API_BASE_URL=https://software.akaarserver.xyz/api/v5
IMAGE_HOSTNAME=software.akaarserver.xyz

DEFAULT_LOCALE=en
NEXT_PUBLIC_OTP_LOGIN=NO

# SSL Commerz Keys
STORE_ID=<your-store-id>
STORE_PASS=<your-store-password>
IS_LIVE=NO

# Facebook Login (Optional)
# FACEBOOK_ID=<your-facebook-app-id>
# FACEBOOK_SECRET=<your-facebook-app-secret>

# bKash Payment Test
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta/tokenized/checkout
BKASH_USERNAME=<your-bkash-username>
BKASH_PASSWORD=<your-bkash-password>
BKASH_APP_KEY=<your-bkash-app-key>
BKASH_APP_SECRET=<your-bkash-app-secret>

# Stripe Payment
STRIPE_WEBHOOK_SECRET=<your-stripe-webhook-secret>
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<your-stripe-publishable-key>
STRIPE_SECRET_KEY=<your-stripe-secret-key>
